{
  "name": "cinnamon-r1f",
  "version": "1.0.0",
  "description": "Cinnamon R1F - WhatsApp Bot Ecosystem",
  "private": true,
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "node dist/apps/bot/src/main.js",
    "dev": "ts-node apps/bot/src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "proto:generate": "protoc --plugin=node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./proto --ts_proto_opt=outputServices=grpc-js,outputServices=defaultGenericClient,useOptionals=true proto/*.proto"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "better-sqlite3": "^11.6.0",
    "drizzle-orm": "^0.36.0",
    "argon2": "^0.41.0",
    "uuid": "^11.0.0",
    "pino": "^9.5.0",
    "baileys": "^6.7.0",
    "sharp": "^0.33.5",
    "fluent-ffmpeg": "^2.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/fluent-ffmpeg": "^2.1.27",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "eslint": "^9.16.0",
    "typescript": "^5.7.0",
    "ts-node": "^10.9.2",
    "vitest": "^2.1.0",
    "drizzle-kit": "^0.28.0",
    "ts-proto": "^2.6.0",
    "protobufjs": "^7.4.0",
    "grpc-tools": "^1.12.4",
    "grpc_tools_node_protoc_ts": "^5.3.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
