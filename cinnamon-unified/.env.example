# ============================================
# Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# WhatsApp Bot Mode: public, group, or self
BOT_MODE=public

# Owner Configuration
OWNER_NUMBER=62895426661666
OWNER_USERNAME=Nyx1024

# Database
DATABASE_PATH=./data/cinnamon.db

# Security
ARGON2_SECRET=random_secret_key_change_in_production

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/cinnamon.log

# Performance
MAX_CONCURRENT_JOBS=20
MEDIA_JOB_TIMEOUT=300000
NETWORK_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_PER_USER=20
RATE_LIMIT_WINDOW=60

# Backup
BACKUP_ENABLED=true
BACKUP_INTERVAL=daily

# C# RPG Engine (optional)
RPG_ENGINE_ENABLED=false
RPG_ENGINE_SOCKET=/tmp/cinnamon-rpg.sock

# Feature Toggles
FEATURE_GAMES=true
FEATURE_RPG=true
FEATURE_FISHING=true
FEATURE_MINING=true
FEATURE_MEDIA=true
FEATURE_DOWNLOADER=true
